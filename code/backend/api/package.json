{
  "name": "@veyroxai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env watch src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "fixture": "tsx --env-file-if-exists=../../.env src/dev/fixture.ts",
    "upload:menu-images": "tsx --env-file-if-exists=../../.env src/dev/upload-menu-images.ts",
    "tokens": "tsx --env-file-if-exists=../../.env src/dev/session-tokens.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.982.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@veyroxai/contracts": "workspace:*",
    "@veyroxai/db": "workspace:*",
    "@veyroxai/domain": "workspace:*",
    "@veyroxai/i18n": "workspace:*",
    "@veyroxai/observability": "workspace:*",
    "bullmq": "6.3.4",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
