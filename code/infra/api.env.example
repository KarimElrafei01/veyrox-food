# Copy to infra/api.env on the server and fill in. chmod 600. Never commit api.env.
# compose.prod.yml reads this via --env-file.

# Only used by the bundled Caddy (compose `--profile edge`). If you proxy with your
# own host Caddy/nginx, ignore this. With nip.io you need no DNS: replace the dots
# in your server's IPv4 with dashes.
API_DOMAIN=65-109-239-222.nip.io

# --- Neon Postgres (ADR-0002). Dev project for now. ---
# App role — RLS applies, not a superuser. Use the DIRECT (non-pooled) host.
DATABASE_URL=postgresql://veyroxai_app:PASSWORD@ep-xxxx.REGION.aws.neon.tech/veyrox_food?sslmode=require
# Migration role — BYPASSRLS. Used by db:migrate only.
DATABASE_ADMIN_URL=postgresql://postgres:PASSWORD@ep-xxxx.REGION.aws.neon.tech/veyrox_food?sslmode=require

# --- Secrets ---
# 32+ random bytes. Generate: openssl rand -hex 32
SESSION_KEY=CHANGE_ME
# For key rotation later; leave empty for now.
SESSION_KEY_PREVIOUS=
# From Meta (WhatsApp app). Any non-empty value works until the webhook is wired.
WHATSAPP_APP_SECRET=CHANGE_ME

LOG_LEVEL=info

# DEV_LOGIN=1 turns on GET /dev/sessions — the order webview shows a café/customer
# picker instead of needing a WhatsApp token. Safe ONLY against the dev database.
# Leave blank for anything with real data.
DEV_LOGIN=

# Comma-separated SPA origins allowed to call this API, e.g.
# https://order.veyroxai.com,https://console.veyroxai.com
# Leave blank in dev — the API then reflects whatever origin calls it.
CORS_ORIGINS=
