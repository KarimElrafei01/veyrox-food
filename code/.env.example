# Copy to .env for local development, then fill in the connection strings.
# `db:migrate`, `db:seed`, and `pnpm dev` load .env from here automatically.
# No secrets in this file — real values live in .env (gitignored) and in the host's
# secret manager in staging/production.
#
# Database + Redis: either `pnpm compose:up` (Docker — the values below match it)
# or a hosted pair. A Neon branch is a supported alternative for Postgres when
# Docker is unavailable (ADR-0002 amendment; README "Local database"). Use the
# DIRECT (non-pooled) Neon host, and DATABASE_ADMIN_URL must have BYPASSRLS.

# --- Database (Postgres 16, ADR-0002) ---
# The application role. Never a superuser. RLS applies to it.
DATABASE_URL=postgres://veyroxai_app:veyroxai_app@localhost:5432/veyrox_food
# Migration/superuser connection used by drizzle-kit and the RLS/trigger bootstrap only.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/veyrox_food

# --- Redis (BullMQ, ADR-0004) ---
# `pnpm compose:up` provides this. `REDIS_URL=memory` is a dev-only in-process
# shim (apps/api dev/memory-redis.ts): every HTTP endpoint works, but the cache is
# per-process and the WhatsApp webhook does not reach a worker. Never in production.
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# --- Frontends (Vite) ---
VITE_API_BASE_URL=http://localhost:3001

# --- Later in Sprint 0 (present so the shape is known) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# SENTRY_DSN=
# FIWANO_API_KEY=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
